{
  "description": "Muestra en Duck los avisos de Codex de este proyecto.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$(/usr/bin/git rev-parse --show-toplevel)/scripts/duck_agent_hook.py\" codex",
            "timeout": 3
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$(/usr/bin/git rev-parse --show-toplevel)/scripts/duck_agent_hook.py\" codex",
            "timeout": 3
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$(/usr/bin/git rev-parse --show-toplevel)/scripts/duck_agent_hook.py\" codex",
            "timeout": 3
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$(/usr/bin/git rev-parse --show-toplevel)/scripts/duck_agent_hook.py\" codex",
            "timeout": 3
          }
        ]
      }
    ],
    "Interrupt": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$(/usr/bin/git rev-parse --show-toplevel)/scripts/duck_agent_hook.py\" codex",
            "timeout": 1
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$(/usr/bin/git rev-parse --show-toplevel)/scripts/duck_agent_hook.py\" codex",
            "timeout": 1
          }
        ]
      }
    ]
  }
}
